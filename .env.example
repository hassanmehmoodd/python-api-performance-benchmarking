# Copy to .env if you want local overrides. Nothing in this file is a secret.
# The demo application has a fixed local token on purpose. Do not reuse it anywhere else.

# Demo API bind address. Leave this on the loopback interface.
DEMO_API_HOST=127.0.0.1
DEMO_API_PORT=8000

# Hosts the benchmark is allowed to call. Comma-separated, case-insensitive.
# The default is localhost, 127.0.0.1, and ::1.
# BENCH_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Upper bound on a concurrency level. Cannot be set above the hard ceiling of 200.
# BENCH_MAX_CONCURRENCY=100

# Targeting a host outside the allowlist requires BOTH of the switches below.
# Use them only for a service you own or are explicitly authorized to test.
# BENCH_ALLOW_REMOTE=1
# BENCH_ACKNOWLEDGE_REMOTE=1
